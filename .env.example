# PostgreSQL connection string. Create an empty local database first.
DATABASE_URL=

# Generate each value independently with a cryptographically secure password manager.
# Keep the operational and platform auth secrets separate.
BETTER_AUTH_SECRET=
PLATFORM_AUTH_SECRET=
FILE_URL_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Used only by `npm run platform:bootstrap`; never commit actual values.
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=
SUPERADMIN_INITIAL_PASSWORD=

# Optional local private-storage path. Defaults to .data/private at runtime.
PRIVATE_STORAGE_DIR=

# Required only when creating the development-only fake inspector fixture.
# Use an operator-controlled Iranian mobile; seed creation does not send SMS.
DEV_FIXTURE_PHONE=

# Required in production and normal development to send operational login OTPs.
# This token is server-only; do not add a NEXT_PUBLIC_ prefix or commit the value.
PARSGREEN_API_TOKEN=

# Test-only OTP sink for local browser E2E. It never sends SMS and is ignored in production.
TAFRIHBAN_TEST_OTP_SINK=

# Optional full browser E2E run. Use a bootstrapped platform account whose
# first-login password change is complete and whose test MFA is disabled.
E2E_SUPERADMIN_EMAIL=
E2E_SUPERADMIN_PASSWORD=
E2E_BASE_URL=
